{
  "pages": {
    "/[locals]/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locals]/layout.css",
      "static/chunks/app/[locals]/layout.js"
    ],
    "/[locals]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locals]/page.js"
    ],
    "/[locals]/images/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locals]/images/page.js"
    ],
    "/[locals]/tours/[id]/[slug]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locals]/tours/[id]/[slug]/page.js"
    ],
    "/[locals]/tours/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locals]/tours/page.js"
    ],
    "/_not-found/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/_not-found/page.js"
    ]
  }
}